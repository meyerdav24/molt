{
  "name": "molt-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Molt: an open protocol for delegating bounded, autonomous spending authority to AI agents. The agent grows a disposable shell for every purchase, wears it once, and sheds it.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:db": "sh scripts/test-db.sh",
    "test:rls": "sh scripts/test-db.sh",
    "test:api": "node scripts/test-api.mjs",
    "demo:reset": "node demo/reset.mjs",
    "test:mcp": "node scripts/test-mcp-e2e.mjs",
    "test:dashboard": "node scripts/test-dashboard.mjs",
    "wallet:init": "node apps/mcp-server/dist/wallet-cli.js init",
    "wallet:address": "node apps/mcp-server/dist/wallet-cli.js address",
    "wallet:balance": "node apps/mcp-server/dist/wallet-cli.js balance"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.12"
    }
  }
}
