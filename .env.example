# ============================================================================
# Molt environment. Copy to .env and fill in. Every variable is explained.
# NOTHING here should ever be a live-money credential. See guardrail G1.
# ============================================================================

# --- Mode gate (OT-080) -----------------------------------------------------
# 'test' is the only supported mode for the hosted beta and default config.
# Boot refuses to start if any Stripe key below is not a test key (sk_test_ /
# rk_test_). 'live_self_hosted' exists only for self-hosters who bring their
# own issuer relationship and their own compliance.
MOLT_MODE=test

# --- Web app / Tab Authority ------------------------------------------------
# Public origin of the web app; WebAuthn RP ID derives from this hostname.
MOLT_PUBLIC_URL=http://localhost:3000
# Secret for session JWTs (short-lived + refresh). Generate:
#   openssl rand -base64 32
MOLT_SESSION_SECRET=

# --- Database (Supabase) ----------------------------------------------------
# Option A (default docker compose): the bundled Postgres below.
# Option B: a cloud Supabase project (EU region) — use its connection values.
DATABASE_URL=postgresql://postgres:postgres@db:5432/molt
# Cloud Supabase only (dashboard RLS reads). Leave empty for local Postgres.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side key. Never exposed to the browser, never committed.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (TEST MODE ONLY — guardrail G1) ---------------------------------
# Restricted test key with Issuing permissions (rk_test_...). A live-shaped
# key here must make the app refuse to boot.
STRIPE_API_KEY=
# Webhook signing secret for issuing_authorization.* / issuing_transaction.*
# events (whsec_..., from `stripe listen` locally).
STRIPE_WEBHOOK_SECRET=

# --- Step-up email (the Tap, OT-024) ----------------------------------------
# Resend or Postmark API key; emails carry approve/deny links that require a
# passkey assertion — the link alone never approves anything.
EMAIL_API_KEY=
EMAIL_FROM=step-up@example.com

# --- x402 / Base Sepolia (Epic 11, guardrail G4) ----------------------------
# Testnet only. The agent operator's wallet key lives ONLY on the operator's
# machine (see OT-112) — there is deliberately no TA-side wallet key variable.
X402_FACILITATOR_URL=https://x402.org/facilitator
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# --- Demo seller ------------------------------------------------------------
DEMO_SELLER_PORT=4021
# Where the demo seller receives testnet USDC (an address, never a key).
DEMO_SELLER_PAY_TO_ADDRESS=
